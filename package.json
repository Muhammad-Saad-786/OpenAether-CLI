{
  "name": "openaether",
  "version": "3.1.1",
  "description": "AI coding CLI powered by OpenRouter - Free and open source",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "openaether": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "chat": "tsx src/cli.ts --chat",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "cli",
    "coding",
    "assistant",
    "openrouter",
    "llm",
    "terminal",
    "developer-tools"
  ],
  "author": "Saad Asim",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Muhammad-Saad-786/openaether-cli"
  },
  "homepage": "https://github.com/Muhammad-Saad-786/openaether-cli#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "groq-sdk": "^1.6.0",
    "ink": "^5.2.1",
    "ink-markdown": "^1.0.4",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^4.67.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.31",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
